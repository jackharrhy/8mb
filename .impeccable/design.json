      "html": "<button class=\"ds-button-primary\">Export video</button>",
      "css": ".ds-button-primary{font-family:Inter,Arial,sans-serif;font-size:14px;color:var(--ink);display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:8px 13px;border:1px solid var(--border);border-radius:6px;background:var(--bg);font-weight:500;cursor:pointer;background:var(--ink);color:var(--on-primary);border-color:var(--ink);}.ds-button-primary:hover{background:var(--muted);}.ds-button-primary:focus-visible{outline:2px solid var(--muted);outline-offset:3px}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{opacity:.55;color:var(--muted);cursor:not-allowed}@media(max-width:480px){.ds-button-primary{min-height:44px}}"
