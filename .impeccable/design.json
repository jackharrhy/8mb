  "narrative": {
    "northStar": "The quiet working surface",
    "overview": "The inherited jack/auth world is a quiet working surface: warm stone neutrals, compact Inter typography, and clearly bounded controls. The video and its editing selections carry the visual attention.\n\nThe interface uses a restrained utility aesthetic with explicit text, aligned numeric fields, and system light/dark themes. The editor stays visually consistent with the command workspace.",
    "keyCharacteristics": [
      "Warm stone neutrals and restrained blue selections.",
      "Compact Inter typography with precise numeric controls.",
      "Flat surfaces, fine separators, and gently rounded controls."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Blue describes editing state; the principal action uses neutral ink.",
        "section": "colors"
      },
      {
        "name": "The Focus Rule",
        "body": "Interactive elements show a muted outline (2px) offset from their edge (3px); unit fields show the same ring around the whole group.",
        "section": "components"
      }
    ],
    "dos": [
      "Do inherit the jack/auth warm stone palette and Inter typography.",
      "Do reserve blue for editing selection, crop mode, and file drop feedback.",
      "Do keep numeric editing alternatives beside direct manipulation.",
      "Do preserve visible keyboard focus and system dark/reduced-motion preferences."
    ],
    "donts": [
      "Don't add decorative shadows or ornamental imagery to the workspace.",
      "Don't turn neutral primary actions into blue promotional buttons.",
      "Don't use monospace for general interface copy; reserve it for commands and output."
    ]
  }
