{
  "name": "8mb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/create-fixtures.mjs && node scripts/browser-check.mjs && node scripts/verify-media.mjs",
    "test:edge": "node scripts/edge-check.mjs",
    "format": "prettier --write src index.html server.mjs scripts test vite.config.ts",
    "prebuild": "node scripts/copy-runtime.mjs",
    "predev": "node scripts/copy-runtime.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@mediabunny/aac-encoder": "1.62.1",
    "lucide": "1.61.0",
    "mediabunny": "1.62.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
